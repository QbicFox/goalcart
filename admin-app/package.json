{
  "name": "goalcart-admin",
  "version": "0.1.0",
  "private": true,
  "description": "Goal Cart admin panel — React SPA (Vite + TypeScript + MUI) mounted inside WP admin.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "makepot": "php ../bin/extract-pot.php",
    "i18n:extract": "php ../bin/extract-pot.php",
    "i18n:build": "php ../bin/build-i18n.php",
    "i18n:verify": "php ../bin/extract-pot.php --check && php ../bin/build-i18n.php --check",
    "i18n:all": "npm run i18n:extract && npm run i18n:verify && npm run i18n:build"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@mui/stylis-plugin-rtl": "^9.3.0",
    "@mui/x-data-grid": "^9.11.0",
    "@mui/x-date-pickers": "^9.11.0",
    "@tanstack/react-query": "^5.101.4",
    "dayjs": "^1.11.21",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "stylis": "^4.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/stylis": "^4.2.7",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1"
  }
}
