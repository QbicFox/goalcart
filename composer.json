{
    "name": "ravis/faracart",
    "description": "FaraCart increases average order value by showing cart missions, progress bars, rewards, milestones, and smart product suggestions for WooCommerce.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "wordpress",
        "woocommerce",
        "cart",
        "missions",
        "aov",
        "upsell"
    ],
    "require": {
        "php": ">=7.4"
    },
    "autoload": {
        "psr-4": {
            "FaraCart\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FaraCart\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
